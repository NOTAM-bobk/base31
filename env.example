# base31.org — environment variables
#
# Copy this file to `.env.local` (never committed) and fill in the real values,
# or set them in Vercel under Project -> Settings -> Environment Variables.
# This example file only lists names — it must never hold a real secret.
#
# The Cloudflare Worker reads its own secrets from Cloudflare (see below), not
# from the Next.js hosting environment, so a few keys appear in both places.

# ---------------------------------------------------------------------------
# Next.js app (Vercel -> Settings -> Environment Variables)
# ---------------------------------------------------------------------------

# Optional. Overrides the Cloudflare Worker URL the homepage calls for the view
# counter and the shared thumbs up/down totals. Falls back to the live
# *.workers.dev deployment when unset.
NEXT_PUBLIC_COUNTER_URL=

# Resend — used by /api/bug-report and the double opt-in / publication emails.
# Also needed as Worker secrets (see the Worker section below).
RESEND_API_KEY=
# Sender address. Use `base31 <onboarding@resend.dev>` until base31.org itself
# is verified with Resend, after which `base31 <reports@base31.org>` works.
RESEND_FROM_EMAIL=
# Inbox that receives bug-report form submissions.
BUG_REPORT_TO=

# Groq — powers the GitHub Explorer AI features (see app/api/github-ai/route.ts).
GROQ_API_KEY=
# Optional. Pins a model instead of letting the route discover an available one.
GROQ_MODEL=

# Cloudflare — only needed to run `npm run deploy:worker` (Wrangler), not at
# request time. Token scopes: Workers Scripts: Edit + Workers KV Storage: Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Cloudflare Worker secrets (`cd worker && npx wrangler secret put <KEY>`)
# ---------------------------------------------------------------------------

# Optional hardening. When set, requests to the worker must send a matching
# `x-counter-secret` header.
COUNTER_SECRET=

# Resend credentials, repeated here because the Worker sends its own emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# VAPID key pair plus a contact URI (e.g. `mailto:hello@base31.org`) for the
# opt-in web push notifications. Only the public key is ever sent to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Note: the KV namespace the Worker stores everything in is configured as the
# `VIEW_COUNTER` binding in worker/wrangler.jsonc — it is a binding, not an
# environment variable, so there is nothing to add here.
